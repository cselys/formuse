# Sector Radar environment variables (all optional — sane defaults are built in).
# Copy this file to `.env` and adjust as needed.

# SQLite database location (default: data/sector_radar.db)
# SECTOR_RADAR_DB_PATH=data/sector_radar.db

# API key for Finnhub (required when data.provider is finnhub)
# SECTOR_RADAR_FINNHUB_API_KEY=your_finnhub_api_key_here

# Logging level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# SECTOR_RADAR_LOG_LEVEL=INFO
